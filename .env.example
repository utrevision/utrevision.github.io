# Copy to .env.local for local builds. .env.local is gitignored.
# Every VITE_ value is embedded in the public site bundle. Do not put passwords or private API keys here.

# reCAPTCHA site key for Firebase App Check. Leave empty until App Check is on.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Enterprise (default) or v3
VITE_APPCHECK_PROVIDER=
# Local dev only. Never set this for the GitHub Pages build.
VITE_APPCHECK_DEBUG_TOKEN=

# Teacher inbox named in the flag email and the questionFlags document.
# Empty uses the default lkh81397@gmail.com.
VITE_FLAG_NOTIFY_EMAIL=lkh81397@gmail.com

# Formspree form id, or the full https://formspree.io/f/<id> endpoint.
# Empty skips email. Flags are still written to Firestore. See DEPLOY.md.
VITE_FLAG_FORMSPREE_ID=
