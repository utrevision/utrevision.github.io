rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: attempts
    // Document ID: auto-id
    // Fields:
    //   - uid: string (required, 1–128 chars, immutable, must equal auth uid)
    //   - displayName: string (required, 1–80 chars)
    //   - quizId: string (required, "lianpo", "8passages", "lianpo-longq-1", "lianpo-longq-2", "lianpo-longq-3", or "eight-longq-1"; immutable on update)
    //   - score: number (required, 0 ≤ score ≤ total, half-point steps)
    //   - total: int (required, 65 for lianpo, 100 for 8passages, 30 for lianpo-longq-1, lianpo-longq-2, lianpo-longq-3, and eight-longq-1)
    //     Long-answer papers store the mark total, not the item count.
    //   - hitRate: number (required). Accept either the real ratio score / total
    //     or the truncating int/int quotient (math.floor of that ratio).
    //     The rules deployed before this change divided two ints with integer
    //     division, so a fractional ratio was rejected. The client writes that
    //     quotient for integer scores, which passes both the old rules and these.
    //   - durationMs: int (required, 0 … 7 days)
    //   - finishedAt: timestamp (required, must equal request.time / serverTimestamp)
    //
    // Signed-in users may read every attempt (leaderboard).
    // A user may create, update, or delete only attempts whose uid is their own.
    // The client keeps one best attempt per uid + quizId: a higher score overwrites
    // that user's document; an equal score overwrites only when the new duration
    // is shorter. Rules cannot query sibling documents, so this is not a rules check.
    // All other paths are denied by default.
    //
    // Collection: aiGradeLogs
    // Document ID: auto-id
    // Written only when Gemini returns a non-empty reason (not blank or literal grades).
    // Fields:
    //   - uid: string (required, 1–128 chars, must equal auth uid)
    //   - quizId: "lianpo" or "8passages"
    //   - stem, target, student, reason: non-empty strings
    //   - score: int, 0 or 1
    //   - createdAt: timestamp, must equal request.time
    // Signed-in users may create their own log docs. They cannot read, update, or delete them.
    //
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function attemptData() {
      return request.resource.data;
    }

    function hasExactKeys() {
      return attemptData().keys().hasOnly([
        'uid',
        'displayName',
        'quizId',
        'score',
        'total',
        'hitRate',
        'durationMs',
        'finishedAt'
      ]);
    }

    function expectedTotal() {
      return attemptData().quizId == 'lianpo'
        ? 65
        : attemptData().quizId == '8passages'
          ? 100
          : attemptData().quizId == 'lianpo-longq-1'
            ? 30
            : attemptData().quizId == 'lianpo-longq-2'
              ? 30
              : attemptData().quizId == 'lianpo-longq-3'
                ? 30
                : attemptData().quizId == 'eight-longq-1'
                  ? 30
                  : -1;
    }

    function isHalfPointScore() {
      return math.floor(attemptData().score * 2) == attemptData().score * 2;
    }

    // float() forces real division. int/int `/` truncates, and comparing that
    // int to a fractional hitRate is an evaluation error (permission denied).
    function isValidHitRate() {
      return attemptData().hitRate is number
        && attemptData().score is number
        && attemptData().total is int
        && attemptData().total > 0
        && attemptData().hitRate >= 0
        && attemptData().hitRate <= 1
        && (
          math.abs(
            float(attemptData().hitRate)
              - (float(attemptData().score) / float(attemptData().total))
          ) <= 0.000001
          || (
            attemptData().score is int
            && attemptData().hitRate is int
            && math.abs(
              float(attemptData().hitRate)
                - math.floor(float(attemptData().score) / float(attemptData().total))
            ) <= 0.000001
          )
        );
    }

    function isValidAttempt() {
      return hasExactKeys()
        && attemptData().uid is string
        && attemptData().uid.size() > 0
        && attemptData().uid.size() <= 128
        && attemptData().uid == request.auth.uid
        && attemptData().displayName is string
        && attemptData().displayName.size() > 0
        && attemptData().displayName.size() <= 80
        && attemptData().quizId is string
        && attemptData().quizId in ['lianpo', '8passages', 'lianpo-longq-1', 'lianpo-longq-2', 'lianpo-longq-3', 'eight-longq-1']
        && attemptData().total is int
        && attemptData().total == expectedTotal()
        && attemptData().score is number
        && attemptData().score >= 0
        && attemptData().score <= attemptData().total
        && isHalfPointScore()
        && isValidHitRate()
        && attemptData().durationMs is int
        && attemptData().durationMs >= 0
        && attemptData().durationMs <= 604800000
        && attemptData().finishedAt == request.time;
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidAttempt();

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && isValidAttempt()
        && attemptData().uid == resource.data.uid
        && attemptData().quizId == resource.data.quizId;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function gradeLogData() {
      return request.resource.data;
    }

    function isValidGradeLog() {
      return gradeLogData().keys().hasOnly([
        'uid',
        'quizId',
        'stem',
        'target',
        'student',
        'score',
        'reason',
        'createdAt'
      ])
        && gradeLogData().uid is string
        && gradeLogData().uid.size() > 0
        && gradeLogData().uid.size() <= 128
        && gradeLogData().uid == request.auth.uid
        && gradeLogData().quizId in ['lianpo', '8passages']
        && gradeLogData().stem is string
        && gradeLogData().stem.size() > 0
        && gradeLogData().stem.size() <= 200
        && gradeLogData().target is string
        && gradeLogData().target.size() > 0
        && gradeLogData().target.size() <= 40
        && gradeLogData().student is string
        && gradeLogData().student.size() > 0
        && gradeLogData().student.size() <= 80
        && gradeLogData().score is int
        && (gradeLogData().score == 0 || gradeLogData().score == 1)
        && gradeLogData().reason is string
        && gradeLogData().reason.size() > 0
        && gradeLogData().reason.size() <= 80
        && gradeLogData().createdAt == request.time;
    }

    match /aiGradeLogs/{logId} {
      allow create: if isSignedIn() && isValidGradeLog();
    }
  }
}
