rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: attempts
    // Document ID: auto-id
    // Fields:
    //   - uid: string (required, 1–128 chars, immutable, must equal auth uid)
    //   - displayName: string (required, 1–80 chars)
    //   - quizId: string (required, "lianpo", "8passages", "lianpo-longq-1", "lianpo-longq-2", "lianpo-longq-3", or "eight-longq-1"; immutable on update)
    //   - score: number (required, 0 ≤ score ≤ total, half-point steps)
    //   - total: int (required, 65 for lianpo, 100 for 8passages, 30 for lianpo-longq-1, lianpo-longq-2, lianpo-longq-3, and eight-longq-1)
    //     Long-answer papers store the mark total, not the item count.
    //   - hitRate: number (required). Accept either the real ratio score / total
    //     or the truncating int/int quotient (math.floor of that ratio).
    //     The rules deployed before this change divided two ints with integer
    //     division, so a fractional ratio was rejected. The client writes that
    //     quotient for integer scores, which passes both the old rules and these.
    //   - durationMs: int (required, 0 … 7 days)
    //   - finishedAt: timestamp (required, must equal request.time / serverTimestamp)
    //
    // Signed-in users may read every attempt (leaderboard).
    // A user may create, update, or delete only attempts whose uid is their own.
    // The client keeps one best attempt per uid + quizId: a higher score overwrites
    // that user's document; an equal score overwrites only when the new duration
    // is shorter. Rules cannot query sibling documents, so this is not a rules check.
    // attempts stores no answer text. Deleting an attempt does not delete latestAnswers.
    // All other paths are denied by default.
    //
    // Collection: latestAnswers
    // Document ID: {uid}_{quizId}  (one document per user per quiz; each finish replaces it)
    // Written on every successful finish, including when the score is not a new best.
    // The map is the student text a later batch regrade needs in order to call
    // resolveGrades / gradeLongPaper again. Rubrics stay in the quiz JSON.
    // Fields:
    //   - uid: string (required, 1–128 chars, immutable, must equal auth uid)
    //   - displayName: string (required, 1–80 chars)
    //   - quizId: string (required, same ids as attempts; immutable on update)
    //   - score: number (required, 0 ≤ score ≤ total, half-point steps)
    //   - total: int (required, same totals as attempts)
    //   - durationMs: int (required, 0 … 7 days)
    //   - finishedAt: timestamp (required, must equal request.time / serverTimestamp)
    //   - answers: map of field id → student string (required, may be empty strings)
    //       Gloss keys are `target｜stem` from glossAnswerKey (banks have no item id).
    //       Long-paper keys are longGradedFieldKeys, including blank fields.
    //       At most 120 entries. Joined keys ≤ 4000 chars, joined values ≤ 12000.
    //       Each value is capped in the client at 1500 chars (rules cannot loop).
    //       Keys are non-empty and contain none of . ~ * / [ ] `
    // Signed-in users may read every latestAnswers doc, same as attempts, so a
    // future teacher tool can list the collection. There is no teacher claim yet,
    // so any signed-in account can read every student's latest script.
    // A user may create or update only the document whose id is their uid + '_' + quizId.
    // Delete is denied. The next finish overwrites the snapshot. A leaderboard
    // delete does not remove it. Rewriting another student's score is not granted
    // here; a batch regrade uses the Admin SDK or a later rules change.
    //
    // Collection: aiGradeLogs
    // Document ID: auto-id
    // Written only when Gemini returns a non-empty reason (not blank or literal grades).
    // Fields:
    //   - uid: string (required, 1–128 chars, must equal auth uid)
    //   - quizId: "lianpo" or "8passages"
    //   - stem, target, student, reason: non-empty strings
    //   - score: int, 0 or 1
    //   - createdAt: timestamp, must equal request.time
    // Signed-in users may create their own log docs. They cannot read, update, or delete them.
    //
    // Collection: questionFlags
    // Document ID: auto-id
    // Written when a signed-in student flags one settlement row.
    // Fields:
    //   - uid: string (required, 1–128 chars, must equal auth uid)
    //   - displayName: string (required, 1–80 chars)
    //   - quizId: one of the attempt quiz ids
    //   - quizTitle, itemId, qNo, stem: non-empty strings within the size caps below
    //   - target, studentAnswer, suggestedAnswer, pointsNote, studentEmail: strings, may be empty
    //   - score, max: numbers on half-point steps, 0 < max ≤ 30, 0 ≤ score ≤ max
    //   - outcome: "對", "半分", or "錯"
    //   - notifyEmail: the teacher inbox named in the message (string with @)
    //   - emailStatus: "sent", "failed", or "skipped"
    //   - finishedAt: timestamp within 30 days before request.time and 2 days after
    //   - createdAt: timestamp, must equal request.time
    // Signed-in users may create their own flag docs. They cannot read, update, or delete
    // them, including their own. Flags contain answers, and the settlement button only
    // needs session state. Teachers read the collection in the Firebase console and by email.
    //
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function attemptData() {
      return request.resource.data;
    }

    function hasExactKeys() {
      return attemptData().keys().hasOnly([
        'uid',
        'displayName',
        'quizId',
        'score',
        'total',
        'hitRate',
        'durationMs',
        'finishedAt'
      ]);
    }

    function expectedTotal() {
      return attemptData().quizId == 'lianpo'
        ? 65
        : attemptData().quizId == '8passages'
          ? 100
          : attemptData().quizId == 'lianpo-longq-1'
            ? 30
            : attemptData().quizId == 'lianpo-longq-2'
              ? 30
              : attemptData().quizId == 'lianpo-longq-3'
                ? 30
                : attemptData().quizId == 'eight-longq-1'
                  ? 30
                  : -1;
    }

    function isHalfPointScore() {
      return math.floor(attemptData().score * 2) == attemptData().score * 2;
    }

    // float() forces real division. int/int `/` truncates, and comparing that
    // int to a fractional hitRate is an evaluation error (permission denied).
    function isValidHitRate() {
      return attemptData().hitRate is number
        && attemptData().score is number
        && attemptData().total is int
        && attemptData().total > 0
        && attemptData().hitRate >= 0
        && attemptData().hitRate <= 1
        && (
          math.abs(
            float(attemptData().hitRate)
              - (float(attemptData().score) / float(attemptData().total))
          ) <= 0.000001
          || (
            attemptData().score is int
            && attemptData().hitRate is int
            && math.abs(
              float(attemptData().hitRate)
                - math.floor(float(attemptData().score) / float(attemptData().total))
            ) <= 0.000001
          )
        );
    }

    function isValidAttempt() {
      return hasExactKeys()
        && attemptData().uid is string
        && attemptData().uid.size() > 0
        && attemptData().uid.size() <= 128
        && attemptData().uid == request.auth.uid
        && attemptData().displayName is string
        && attemptData().displayName.size() > 0
        && attemptData().displayName.size() <= 80
        && attemptData().quizId is string
        && attemptData().quizId in ['lianpo', '8passages', 'lianpo-longq-1', 'lianpo-longq-2', 'lianpo-longq-3', 'eight-longq-1']
        && attemptData().total is int
        && attemptData().total == expectedTotal()
        && attemptData().score is number
        && attemptData().score >= 0
        && attemptData().score <= attemptData().total
        && isHalfPointScore()
        && isValidHitRate()
        && attemptData().durationMs is int
        && attemptData().durationMs >= 0
        && attemptData().durationMs <= 604800000
        && attemptData().finishedAt == request.time;
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidAttempt();

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && isValidAttempt()
        && attemptData().uid == resource.data.uid
        && attemptData().quizId == resource.data.quizId;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function latestData() {
      return request.resource.data;
    }

    // Keep these totals aligned with expectedTotal().
    function latestExpectedTotal() {
      return latestData().quizId == 'lianpo'
        ? 65
        : latestData().quizId == '8passages'
          ? 100
          : latestData().quizId == 'lianpo-longq-1'
            ? 30
            : latestData().quizId == 'lianpo-longq-2'
              ? 30
              : latestData().quizId == 'lianpo-longq-3'
                ? 30
                : latestData().quizId == 'eight-longq-1'
                  ? 30
                  : -1;
    }

    function isLatestHalfPointScore() {
      return math.floor(latestData().score * 2) == latestData().score * 2;
    }

    // values().join fails closed when any value is not a string.
    function isValidAnswerMap() {
      return latestData().answers is map
        && latestData().answers.size() <= 120
        && !latestData().answers.keys().hasAny([''])
        && !latestData().answers.keys().join('').matches('.*[.~*/\\[\\]`].*')
        && latestData().answers.keys().join('').size() <= 4000
        && latestData().answers.values().join('').size() <= 12000;
    }

    function isValidLatestAnswer() {
      return latestData().keys().hasOnly([
        'uid',
        'displayName',
        'quizId',
        'score',
        'total',
        'durationMs',
        'finishedAt',
        'answers'
      ])
        && latestData().uid is string
        && latestData().uid.size() > 0
        && latestData().uid.size() <= 128
        && latestData().uid == request.auth.uid
        && latestData().displayName is string
        && latestData().displayName.size() > 0
        && latestData().displayName.size() <= 80
        && latestData().quizId is string
        && latestData().quizId in ['lianpo', '8passages', 'lianpo-longq-1', 'lianpo-longq-2', 'lianpo-longq-3', 'eight-longq-1']
        && latestData().total is int
        && latestData().total == latestExpectedTotal()
        && latestData().score is number
        && latestData().score >= 0
        && latestData().score <= latestData().total
        && isLatestHalfPointScore()
        && latestData().durationMs is int
        && latestData().durationMs >= 0
        && latestData().durationMs <= 604800000
        && latestData().finishedAt == request.time
        && isValidAnswerMap();
    }

    match /latestAnswers/{answerId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isValidLatestAnswer()
        && answerId == request.auth.uid + '_' + latestData().quizId;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && isValidLatestAnswer()
        && answerId == request.auth.uid + '_' + latestData().quizId
        && latestData().uid == resource.data.uid
        && latestData().quizId == resource.data.quizId;
    }

    function gradeLogData() {
      return request.resource.data;
    }

    function isValidGradeLog() {
      return gradeLogData().keys().hasOnly([
        'uid',
        'quizId',
        'stem',
        'target',
        'student',
        'score',
        'reason',
        'createdAt'
      ])
        && gradeLogData().uid is string
        && gradeLogData().uid.size() > 0
        && gradeLogData().uid.size() <= 128
        && gradeLogData().uid == request.auth.uid
        && gradeLogData().quizId in ['lianpo', '8passages']
        && gradeLogData().stem is string
        && gradeLogData().stem.size() > 0
        && gradeLogData().stem.size() <= 200
        && gradeLogData().target is string
        && gradeLogData().target.size() > 0
        && gradeLogData().target.size() <= 40
        && gradeLogData().student is string
        && gradeLogData().student.size() > 0
        && gradeLogData().student.size() <= 80
        && gradeLogData().score is int
        && (gradeLogData().score == 0 || gradeLogData().score == 1)
        && gradeLogData().reason is string
        && gradeLogData().reason.size() > 0
        && gradeLogData().reason.size() <= 80
        && gradeLogData().createdAt == request.time;
    }

    match /aiGradeLogs/{logId} {
      allow create: if isSignedIn() && isValidGradeLog();
    }

    function flagData() {
      return request.resource.data;
    }

    function isHalfStep(value) {
      return value is number && math.floor(value * 2) == value * 2;
    }

    function isValidQuestionFlag() {
      return flagData().keys().hasOnly([
        'uid',
        'displayName',
        'quizId',
        'quizTitle',
        'itemId',
        'qNo',
        'stem',
        'target',
        'studentAnswer',
        'suggestedAnswer',
        'pointsNote',
        'score',
        'max',
        'outcome',
        'studentEmail',
        'notifyEmail',
        'emailStatus',
        'finishedAt',
        'createdAt'
      ])
        && flagData().uid is string
        && flagData().uid.size() > 0
        && flagData().uid.size() <= 128
        && flagData().uid == request.auth.uid
        && flagData().displayName is string
        && flagData().displayName.size() > 0
        && flagData().displayName.size() <= 80
        && flagData().quizId in ['lianpo', '8passages', 'lianpo-longq-1', 'lianpo-longq-2', 'lianpo-longq-3', 'eight-longq-1']
        && flagData().quizTitle is string
        && flagData().quizTitle.size() > 0
        && flagData().quizTitle.size() <= 160
        && flagData().itemId is string
        && flagData().itemId.size() > 0
        && flagData().itemId.size() <= 200
        && flagData().qNo is string
        && flagData().qNo.size() > 0
        && flagData().qNo.size() <= 16
        && flagData().stem is string
        && flagData().stem.size() > 0
        && flagData().stem.size() <= 2000
        && flagData().target is string
        && flagData().target.size() <= 80
        && flagData().studentAnswer is string
        && flagData().studentAnswer.size() <= 8000
        && flagData().suggestedAnswer is string
        && flagData().suggestedAnswer.size() <= 8000
        && flagData().pointsNote is string
        && flagData().pointsNote.size() <= 8000
        && flagData().max is number
        && isHalfStep(flagData().max)
        && flagData().max > 0
        && flagData().max <= 30
        && flagData().score is number
        && isHalfStep(flagData().score)
        && flagData().score >= 0
        && flagData().score <= flagData().max
        && flagData().outcome in ['對', '半分', '錯']
        && flagData().studentEmail is string
        && flagData().studentEmail.size() <= 254
        && (flagData().studentEmail.size() == 0 || flagData().studentEmail.matches('.+@.+[.].+'))
        && flagData().notifyEmail is string
        && flagData().notifyEmail.size() > 3
        && flagData().notifyEmail.size() <= 120
        && flagData().notifyEmail.matches('.+@.+[.].+')
        && flagData().emailStatus in ['sent', 'failed', 'skipped']
        && flagData().finishedAt is timestamp
        && flagData().finishedAt > (request.time - duration.value(30, 'd'))
        && flagData().finishedAt < (request.time + duration.value(2, 'd'))
        && flagData().createdAt == request.time;
    }

    match /questionFlags/{flagId} {
      allow create: if isSignedIn() && isValidQuestionFlag();
    }
  }
}
